# ===== Secrets — 永远不进 git =====
.env
.env.*
!.env.*.example
.env.agent
.env.local

# ===== Orchestration 运行时状态 =====
# state/ 整体 ignore，但保留目录骨架（.gitkeep）和初始 budget.json
state/*
!state/.gitkeep
!state/queue/
!state/ready/
!state/in_progress/
!state/awaiting_ci/
!state/done/
!state/failed/
!state/needs_human/
!state/blocked/
!state/logs/
!state/budget.json
!state/events.jsonl
state/queue/*
state/ready/*
state/in_progress/*
state/awaiting_ci/*
state/done/*
state/failed/*
state/needs_human/*
state/blocked/*
state/logs/*
!state/queue/.gitkeep
!state/ready/.gitkeep
!state/in_progress/.gitkeep
!state/awaiting_ci/.gitkeep
!state/done/.gitkeep
!state/failed/.gitkeep
!state/needs_human/.gitkeep
!state/blocked/.gitkeep
!state/logs/.gitkeep

# stop_signal 是运行时文件
state/stop_signal

# ===== Worktrees（在 repo 外，但保险起见） =====
.worktrees/

