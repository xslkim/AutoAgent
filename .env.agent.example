# ============================================================
# Python agent 专用 secret（不进 git，仅在 D:\AutoAgent\.env.agent）
# ============================================================
# 用途: scripts/agent/run_task.py spawn `claude -p` 时通过 env= 显式传入
# 隔离原则:
#   1. 这个 key 与顶层 Claude Code 客户端用的 key **必须不同账户**
#      （便于独立计费 + 即使泄露也只影响 agent 子账户）
#   2. Python agent 的 subprocess 调用必须显式 env={...}，不继承父进程
#   3. 这个文件本身用 600 权限 (chmod 600 .env.agent)
#   4. 永远不要在 task prompt / log / commit message 里出现这两个值
# ============================================================

# Anthropic API key（独立子账户，每月预算 cap 建议 $300）
# 申请: https://console.anthropic.com/settings/keys
AGENT_ANTHROPIC_KEY=sk-ant-PLACEHOLDER

# GitHub Personal Access Token（最小权限：repo + workflow + pull-requests）
# 仅授权 D:\AutoAgent 这一个 repo
# 申请: https://github.com/settings/tokens?type=beta
AGENT_GITHUB_TOKEN=github_pat_PLACEHOLDER

# 可选: 自定义 claude CLI 路径（默认从 PATH 找）
# CLAUDE_CLI_PATH=C:\Users\elane\.claude\claude.cmd

# 可选: worktree 根目录（默认 D:\AutoAgent.worktrees）
# WORKTREE_ROOT=D:\AutoAgent.worktrees
