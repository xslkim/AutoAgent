# ============================================================
# Python agent 专用 secret（不进 git，仅在 D:\AutoAgent\.env.agent）
# ============================================================
# 用途: scripts/agent/run_task.py spawn opencode 时通过 env= 显式传入
# 隔离原则:
#   1. 下面的 key 与交互式客户端用的 key 建议分账户
#      （便于独立计费 + 即使泄露也只影响 agent 子账户）
#   2. Python agent 的 subprocess 调用必须显式 env={...}，不继承父进程
#   3. 这个文件本身用 600 权限 (chmod 600 .env.agent)
#   4. 永远不要在 task prompt / log / commit message 里出现这两个值
# ============================================================

# ---------- AI agent (opencode + DeepSeek) ----------
# opencode 的 API key 由 ~/.config/opencode/opencode.json 管理，
# 通常不需要在这里重复配置。
# 如果你需要在隔离 env 里显式注入（不依赖 opencode 的全局 config），
# 取消下面这行注释并填入你的 DeepSeek API key:
# AGENT_DEEPSEEK_KEY=sk-PLACEHOLDER

# ---------- GitHub ----------
# GitHub Personal Access Token（最小权限：repo + workflow）
# 申请: https://github.com/settings/tokens?type=beta
AGENT_GITHUB_TOKEN=github_pat_PLACEHOLDER

# ---------- 可选覆盖 ----------
# opencode model（默认使用 ~/.config/opencode/opencode.json 里配置的 model）
# AGENT_MODEL=deepseek/deepseek-v4-pro

# opencode CLI 路径（默认从 PATH 找）
# OPENCODE_CLI_PATH=C:\Users\xsl\AppData\Roaming\npm\opencode.cmd

# worktree 根目录（默认 D:\AutoAgent.worktrees）
# WORKTREE_ROOT=D:\AutoAgent.worktrees
